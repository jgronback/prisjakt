# Värmekamera – Apache-regler (fungerar på Strato och de flesta delade webbhotell)
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType font/woff2 .woff2
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
RewriteEngine On
# tvinga https + www så att det bara finns en kanonisk adress
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^varmekameror\.se$ [NC]
RewriteRule ^(.*)$ https://www.varmekameror.se/$1 [R=301,L]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(woff2)$">
Header set Access-Control-Allow-Origin "*"
</FilesMatch>
</IfModule>
