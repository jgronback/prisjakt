// prisma/schema.prisma
// Läs mer: https://pris.ly/d/prisma-schema

// ===== DATASOURCE: Postgres (Neon) via DATABASE_URL =====
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== GENERATOR: Prisma Client =====
generator client {
  provider = "prisma-client-js"
}

// ===== MODELS =====

// Shopify-sessioner (krävs av @shopify/shopify-app-session-storage-prisma)
model Session {
  id            String   @id
  shop          String
  state         String
  isOnline      Boolean  @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean  @default(false)
  locale        String?
  collaborator  Boolean? @default(false)
  emailVerified Boolean? @default(false)

  @@index([shop])
  @@index([isOnline])
}

// Appens egna inställningar per butik
model ShopSettings {
  shop        String   @id
  feedSecret  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}
